{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corpus _MANIFEST.json",
  "description": "The manifest of one cleaned dataset version (formats/corpus-shard.md), written by data.06.",
  "type": "object",
  "required": ["dataset", "version", "n_docs", "n_shards", "shards", "filters", "dedup", "pii", "ledger_ref", "config_sha256"],
  "additionalProperties": false,
  "properties": {
    "dataset": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "n_docs": {"type": "integer", "minimum": 0},
    "n_shards": {"type": "integer", "minimum": 1},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "rows"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^shard-[0-9]{5}-of-[0-9]{5}\\.parquet$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "rows": {"type": "integer", "minimum": 0}
        }
      }
    },
    "filters": {
      "type": "object",
      "description": "Documents dropped by each quality filter, by filter name.",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "dedup": {
      "type": "object",
      "required": ["exact_dropped", "near_dropped", "decontaminated", "jaccard_threshold", "num_perm", "bands", "ngram"],
      "additionalProperties": false,
      "properties": {
        "exact_dropped": {"type": "integer", "minimum": 0},
        "near_dropped": {"type": "integer", "minimum": 0},
        "decontaminated": {"type": "integer", "minimum": 0},
        "jaccard_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "num_perm": {"type": "integer", "minimum": 1},
        "bands": {"type": "integer", "minimum": 1},
        "ngram": {"type": "integer", "minimum": 1}
      }
    },
    "pii": {
      "type": "object",
      "required": ["emails", "phones", "cards", "ips", "keys"],
      "additionalProperties": false,
      "properties": {
        "emails": {"type": "integer", "minimum": 0},
        "phones": {"type": "integer", "minimum": 0},
        "cards": {"type": "integer", "minimum": 0},
        "ips": {"type": "integer", "minimum": 0},
        "keys": {"type": "integer", "minimum": 0}
      }
    },
    "ledger_ref": {"type": "string", "minLength": 1},
    "config_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "examples": [
    {
      "dataset": "tinystories",
      "version": "v1",
      "n_docs": 33121,
      "n_shards": 1,
      "shards": [{"name": "shard-00000-of-00001.parquet", "sha256": "4444444444444444444444444444444444444444444444444444444444444444", "rows": 33121}],
      "filters": {"lang": 1203, "gopher": 8812, "repetition": 77, "ppl": 0},
      "dedup": {"exact_dropped": 5120, "near_dropped": 18044, "decontaminated": 12, "jaccard_threshold": 0.8, "num_perm": 128, "bands": 16, "ngram": 13},
      "pii": {"emails": 3, "phones": 0, "cards": 0, "ips": 1, "keys": 0},
      "ledger_ref": "corpus/LEDGER.jsonl",
      "config_sha256": "5555555555555555555555555555555555555555555555555555555555555555"
    }
  ]
}
