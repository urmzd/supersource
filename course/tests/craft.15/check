#!/usr/bin/env bash
set -euo pipefail
root="$PWD"
missing=0
artifact="$root/docs/maintenance/dependency-upgrades.md"
if [ ! -s "$artifact" ]; then echo "craft.15: missing docs/maintenance/dependency-upgrades.md" >&2; missing=1
else
  for evidence in 'Resolved graph' 'govulncheck' 'p95' 'Rollback' 'Owner'; do
    if ! grep -qi "$evidence" "$artifact"; then echo "craft.15: dependency review lacks '$evidence' evidence" >&2; missing=1; fi
  done
fi
exit "$missing"
