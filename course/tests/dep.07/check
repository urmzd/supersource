#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
python3 - <<'PY'
import tomllib
from pathlib import Path
name = tomllib.loads(Path('system.toml').read_text())['system']['name']
for path in ('deploy/docker/agent.Dockerfile', f'deploy/helm/{name}-agent/values.schema.json'):
    if not Path(path).is_file():
        raise SystemExit(f'dep.07: {path} is missing')
PY
export SS_REPO="$PWD" SS_COURSE_TREE="${SS_COURSE_TREE:-$(cd "$tests/.." && pwd)}" PYTHONPATH="$tests" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --python ">=3.11" --quiet --with pytest python -m pytest -q -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
