#!/usr/bin/env bash
set -euo pipefail
root="$PWD"
missing=0
artifact="$root/docs/maintenance/perf-bisect.md"
if [ ! -s "$artifact" ]; then echo "craft.16: missing docs/maintenance/perf-bisect.md" >&2; missing=1
else
  for evidence in 'Workload' 'warm-up' 'median' 'git bisect run' 'Rollback' 'Owner'; do
    if ! grep -qi "$evidence" "$artifact"; then echo "craft.16: bisect record lacks '$evidence' evidence" >&2; missing=1; fi
  done
fi
exit "$missing"
