#!/usr/bin/env bash
set -euo pipefail
root="$PWD"
missing=0
artifact="$root/docs/THREAT_MODEL.md"
if [ ! -s "$artifact" ]; then echo "craft.17: missing docs/THREAT_MODEL.md" >&2; missing=1
else
  for evidence in Spoofing Tampering Repudiation Disclosure 'Denial of service' 'Elevation of privilege' Boundary Owner; do
    if ! grep -qi "$evidence" "$artifact"; then echo "craft.17: threat model lacks '$evidence' analysis" >&2; missing=1; fi
  done
fi
exit "$missing"
