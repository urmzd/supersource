#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path
p = Path("docs/runbooks/KvV2Migration.md")
if not p.is_file():
    raise SystemExit("ops.04: missing docs/runbooks/KvV2Migration.md")
text = p.read_text(encoding="utf-8").lower()
required = ("owner", "precondition", "canary", "rollback", "verification", "v1", "v2", "scale", "hash")
missing = [item for item in required if item not in text]
if len(text.split()) < 180 or missing:
    raise SystemExit(f"ops.04: incomplete migration runbook; missing={missing}, words={len(text.split())}")
PY
