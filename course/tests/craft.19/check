#!/usr/bin/env bash
set -euo pipefail
root="$PWD"
missing=0
artifact="$root/docs/security-review.md"
if [ ! -s "$artifact" ]; then echo "craft.19: missing docs/security-review.md" >&2; missing=1
else
  for evidence in 'Authorization matrix' 'constant-time' 'cache window' 'cross-tenant' 'rotation' 'Owner'; do
    if ! grep -qi "$evidence" "$artifact"; then echo "craft.19: security review lacks '$evidence' evidence" >&2; missing=1; fi
  done
fi
exit "$missing"
