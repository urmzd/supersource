#!/usr/bin/env bash
set -euo pipefail
root="$PWD"
missing=0
for sbom in docs/sbom/engine.spdx.json docs/sbom/gateway.spdx.json; do
  artifact="$root/$sbom"
  if [ ! -s "$artifact" ]; then echo "craft.18: missing $sbom" >&2; missing=1
  else
    for evidence in SPDX-2.3 packages relationships NOASSERTION; do
      if ! grep -q "$evidence" "$artifact"; then echo "craft.18: $sbom lacks '$evidence'" >&2; missing=1; fi
    done
  fi
done
exit "$missing"
