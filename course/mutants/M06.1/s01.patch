+        for p in parents(n):
+            s = state.get(id(p))
+            if s is None:
+                visit(p)
+            elif s == _ON_STACK:
+                raise ValueError("toposort: the graph has a cycle reachable from root")
+        state[id(n)] = _DONE
+        post.append(n)
+
+    visit(root)
+    post.reverse()
