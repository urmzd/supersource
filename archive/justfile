# Recipes for archived coursework (archive/README.md). Run from the repo root:
#   just --justfile archive/justfile --working-directory . <recipe>

set shell := ["bash", "-cu"]

help:
  @just --justfile archive/justfile --list

run-12-concurrency-systems:
  make -C archive/algorithms/12-concurrency-systems/miner
  cd archive/algorithms/12-concurrency-systems && \
    for cfg in tests/test.*.cfg; do \
      id=${cfg##*/}; id=${id#test.}; id=${id%.cfg}; \
      ./tests/test.sh "$id"; \
    done

run-13-functional-programming:
  echo "Scheme files; run with a Scheme interpreter (e.g., racket or guile)."
  echo "Example: racket archive/algorithms/13-functional-programming/Factors.scm"

run-14-ml-statistics:
  echo "Use subcommands: run-14-ml-statistics-nlp or run-14-ml-statistics-r-exercises"

run-14-ml-statistics-nlp:
  echo "Python: python3 archive/algorithms/14-ml-statistics/nlp/hmm_tagger.py"
  echo "Prolog: swipl -s archive/algorithms/14-ml-statistics/nlp/dcg.pl"
  echo "Perl: perl archive/algorithms/14-ml-statistics/nlp/a1q4.pl"

run-14-ml-statistics-r-exercises:
  echo "R: Rscript archive/algorithms/14-ml-statistics/r-exercises/exercise-1/q4.r"
